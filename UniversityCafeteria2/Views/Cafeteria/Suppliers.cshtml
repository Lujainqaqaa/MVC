@{
    Layout = "_SimpleLayout";

    string[] suppliers = {
        "Fresh Food Company",
        "Happy Drinks Company",
        "Daily Supplies Company"
    };
}

<h1 class="text-primary">Cafeteria Suppliers</h1>

<h4 class="mt-4">Suppliers List</h4>

<ul class="list-group mt-3">

    @foreach (string supplier in suppliers)
    {
        <li class="list-group-item">
            @supplier
        </li>
    }

</ul>

@if (suppliers.Length >= 3)
{
    <h4 class="text-success mt-4">
        We have enough suppliers.
    </h4>
}
else
{
    <h4 class="text-danger mt-4">
        We need more suppliers.
    </h4>
}
