@{
    string universityName = "Orange University";
    string managerName = "Ahmad Ali";
    int totalProducts = 5;
}

<h1 class="text-primary">Welcome to @universityName</h1>

<h3>University Cafeteria Supply Management System</h3>

<div class="card mt-4">
    <div class="card-body">

        <h4>Cafeteria Information</h4>

        <p>
            <strong>University Name:</strong>
            @universityName
        </p>

        <p>
            <strong>Manager Name:</strong>
            @managerName
        </p>

        <p>
            <strong>Total Products:</strong>
            @totalProducts
        </p>

    </div>
</div>
