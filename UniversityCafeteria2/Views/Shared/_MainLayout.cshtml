
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>University Cafeteria</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />
</head>

<body>

    <header class="bg-dark text-white p-3">
        <div class="container">
            <h2>University Cafeteria</h2>

            <nav class="mt-3">
                <a href="/Cafeteria/Index"
                   class="text-white me-3">Home</a>

                <a href="/Cafeteria/Products"
                   class="text-white me-3">Products</a>

                <a href="/Cafeteria/Suppliers"
                   class="text-white me-3">Suppliers</a>

                <a href="/Cafeteria/SupplyStatus"
                   class="text-white">Supply Status</a>
            </nav>
        </div>
    </header>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <footer class="bg-dark text-white text-center p-3 mt-5">
        <p>University Cafeteria &copy; 2026</p>
    </footer>

    @RenderSection("Scripts", required: false)

</body>
</html>

