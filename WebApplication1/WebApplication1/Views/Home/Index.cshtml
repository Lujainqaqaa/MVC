@{

    string[] products = {
        "Coffee", "Tea", "Juice"
    };

    double[] prices = { 2.5, 1.5, 3.0 };

    int[] quantities = { 10, 0, 5 };
}

<h2>Products List</h2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Product</th>
            <th>Price</th>
            <th>Status</th>
        </tr>
    </thead>

    <tbody>
        @for (int i = 0; i < products.Length; i++)
        {
            <tr>
                <td>@products[i]</td>
                <td>@prices[i] JD</td>
                <td>
                    @if (quantities[i] > 0)
                    {
                        <span class="text-success">
                            Available
                        </span>
                    }
                    else
                    {
                        <span class="text-danger">
                            Out of Stock
                        </span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
