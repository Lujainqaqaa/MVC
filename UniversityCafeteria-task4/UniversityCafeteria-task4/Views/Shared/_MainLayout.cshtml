<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>University Cafeteria</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
</head>
<body>
    <header class="bg-dark text-white p-3">
        <div class="container">
            <h2>University Cafeteria</h2>

            <nav class="d-flex flex-wrap gap-3">
                <a class="text-white"
                   href="@Url.Action("Index", "Home")">Home</a>

                <a class="text-white"
                   href="@Url.Action("Products", "Home")">Products</a>

                <a class="text-white"
                   href="@Url.Action("Suppliers", "Home")">Suppliers</a>

                <a class="text-white"
                   href="@Url.Action("Index", "SupplyRequest")">Create Supply Request</a>

                <a class="text-white"
                   href="@Url.Action("Review", "SupplyRequest")">Review Draft</a>

                <a class="text-white"
                   href="@Url.Action("MyRequests", "SupplyRequest")">My Requests</a>

                <a class="text-white"
                   href="@Url.Action("About", "SupplyRequest")">About</a>
            </nav>
        </div>
    </header>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <footer class="text-center mt-5">
        University Cafeteria &copy; 2026
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>