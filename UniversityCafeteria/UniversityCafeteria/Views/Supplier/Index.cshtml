@model IEnumerable<Supplier>

<h2>Suppliers</h2>

@Html.ActionLink("Add New", "Create", "Supplier",
    null, new { @class = "btn btn-primary mb-3" })

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Address</th>
            <th>Products Count</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Phone</td>
                <td>@item.Email</td>
                <td>@item.Address</td>
                <td>@item.Products.Count</td>
                <td>
                    @Html.ActionLink("Edit", "Edit",
                        new { id = item.Id })

                    @Html.ActionLink("Details", "Details",
                        new { id = item.Id })

                    @using (Html.BeginForm("Delete", "Supplier",
                        new { id = item.Id }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <button class="btn btn-danger btn-sm"
                                onclick="return confirm('Delete supplier?')">
                            Delete
                        </button>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>